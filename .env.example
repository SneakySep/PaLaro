# =========================================================
# PaLaro — environment template
# Copy this file to `.env` (root, for Docker) and
# `backend/.env` (for the FastAPI app), then fill in values.
# NEVER commit real `.env` files.
# =========================================================

# ---- PostgreSQL (used by docker-compose.yml) ----
POSTGRES_USER=palaro
POSTGRES_PASSWORD=palaro_dev
POSTGRES_DB=palaro
POSTGRES_PORT=5432

# ---- Backend (FastAPI app) ----
# SQLAlchemy async/psycopg connection string matching the compose values above
DATABASE_URL=postgresql+psycopg://palaro:palaro_dev@localhost:5432/palaro
# Keep the CORS origin(s) tight. In dev, allow the Next.js app:
CORS_ORIGINS=["http://localhost:3000"]

# ---- Frontend (Next.js) ----
# Base URL of the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- ML ----
# Version tag attached to predictions; bump after retraining
MODEL_VERSION=0.1.0
MODEL_ARTIFACT_PATH=ml/model_artifacts/xgb_model.ubj
FEATURE_COLUMNS_PATH=ml/model_artifacts/feature_columns.json

# ---- nba_api ingestion (stats.nba.com headers) ----
NBA_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36
